      "shell-quote": ">=1.11.0",
      "sharp@<0.35.5": ">=0.35.5",
      "follow-redirects@>=1.16.0 <1.16.1": ">=1.16.1",
      "fastify@>=5.12.2 <5.12.6": ">=5.12.6",
      "toml@<=5.0.0": ">=5.0.1",
      "decode-uri-component@0.5.0": ">=0.5.1 <1.0.0",
      "follow-redirects@1.16.1": ">=1.16.2 <2.0.0",
