{
  "name": "apexsociety",
  "version": "1.0.0",
  "description": "ApexSociety - The social platform for car enthusiasts. Find meets, join crews, and share your automotive lifestyle.",
  "main": "index.ts",
  "author": "ApexSociety",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/juninmd/ApexSociety.git"
  },
  "homepage": "https://juninmd.github.io/ApexSociety",
  "keywords": [
    "react-native",
    "expo",
    "social",
    "cars"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "preweb": "ts-node --project tsconfig.node.json scripts/update-html-metadata.ts && ts-node --project tsconfig.node.json scripts/generate-sitemap.ts && ts-node --project tsconfig.node.json scripts/generate-security-txt.ts",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "prebuild:web": "ts-node --project tsconfig.node.json scripts/update-html-metadata.ts && ts-node --project tsconfig.node.json scripts/generate-sitemap.ts && ts-node --project tsconfig.node.json scripts/generate-security-txt.ts",
    "build:gh-pages": "cross-env GH_PAGES=true expo export -p web && ts-node --project tsconfig.node.json scripts/cp-404.ts",
    "prebuild:gh-pages": "ts-node --project tsconfig.node.json scripts/update-html-metadata.ts && ts-node --project tsconfig.node.json scripts/generate-sitemap.ts && ts-node --project tsconfig.node.json scripts/generate-security-txt.ts",
    "deploy": "pnpm run build:gh-pages && gh-pages -d dist",
    "deploy:netlify": "npx --yes netlify-cli@latest deploy --prod --dir=dist",
    "test:ci": "jest --ci --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:e2e": "pnpm run build:web && node e2e/run-e2e.mjs",
    "prepare": "husky",
    "preview": "serve dist"
  },
  "dependencies": {
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "babel-preset-expo": "~58.0.24",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo": "~58.0.23",
    "expo-blur": "^58.0.5",
    "expo-font": "^58.0.11",
    "expo-linear-gradient": "^58.0.3",
    "expo-linking": "^58.0.16",
    "expo-location": "^58.0.20",
    "expo-status-bar": "~58.0.4",
    "follow-redirects": "^1.16.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/runtime": "^8.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "body-parser": "^2.4.0",
    "brace-expansion": "^5.0.9",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "eslint": "10.14.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "fast-uri": "^4.2.3",
    "fastify": "^5.12.8",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "image-size": "2.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "jiti": "^2.7.0",
    "js-yaml": "^5.5.0",
    "lint-staged": "^17.6.0",
    "lucide-react-native": "^1.69.0",
    "netlify-cli": "^27.16.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react-test-renderer": "19.3.1",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.8.0",
    "undici": "^8.12.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^3.0.4",
      "@tootallnate/once": "^3.0.1",
      "test-exclude": "^6.0.0",
      "undici": ">=6.28.1",
      "flatted": "^3.4.2",
      "fastify": ">=5.12.5",
      "@fastify/static": ">=10.1.2",
      "brace-expansion": ">=5.0.12",
      "picomatch": ">=4.0.4",
      "fast-uri": ">=4.2.3",
      "cookie": ">=1.0.2",
      "@xmldom/xmldom": ">=0.9.12",
      "postcss": ">=8.5.23",
      "uuid": ">=14.0.0",
      "defu": ">=6.1.5",
      "tar": ">=7.5.21",
      "esbuild": ">=0.28.1",
      "@eslint/plugin-kit": ">=0.3.4",
      "js-yaml": ">=5.4.1",
      "nanoid": ">=3.3.18",
      "ws": ">=8.20.1",
      "@opentelemetry/core": ">=2.8.0",
      "http-proxy-middleware": ">=3.0.6",
      "find-my-way": ">=9.7.0",
      "sharp": ">=0.35.4",
      "multiparty": ">=4.3.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "netlify-cli": "^27.16.2",
      "ipx": ">=2.1.2",
      "qs": ">=6.16.0",
      "file-type": ">=21.3.1",
      "lodash": ">=4.18.0",
      "tmp": ">=0.2.4",
      "body-parser": ">=1.20.6",
      "@xhmikosr/decompress": ">=10.2.1",
      "path-to-regexp": ">=0.1.13",
      "@octokit/plugin-paginate-rest": ">=11.4.1",
      "decode-uri-component@<=0.4.2": ">=0.5.0",
      "toml": ">=4.2.0",
      "browserslist": ">=4.28.7",
      "compression": ">=1.8.2",
      "source-map-js": ">=1.2.2",
      "proxy-addr": ">=2.0.8",
